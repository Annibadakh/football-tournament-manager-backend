# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Frontend base URL, used in email links (invites)
APP_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maidaan
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false

# Auth. Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
# Use "none" in production when frontend and API are on different domains
COOKIE_SAME_SITE=lax

# Email (Nodemailer SMTP). Gmail: smtp.gmail.com, port 465, an App Password (not the account password).
# Leave SMTP_HOST empty in development to print emails to the server log instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Maidaan <maidaan.app@gmail.com>

# File storage (AWS S3, private bucket). Credentials via AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or an IAM role.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for local S3 emulators (MinIO/moto). Leave empty for real AWS.
S3_ENDPOINT=
S3_SIGNED_URL_TTL_SECONDS=3600

# Google Places (server key, restricted to this server's IP; enable Places API (New)).
# Leave empty in development to use built-in sample Maharashtra places.
GOOGLE_MAPS_API_KEY=

# Razorpay (Dashboard → Account & Settings → API keys). Use test keys (rzp_test_...) in development.
# Webhook: <api>/api/v1/payments/webhook with events payment.captured, order.paid, payment.failed.
# Leave the keys empty to disable online payments (organizers can still record offline payments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Convenience fee added to online payments, in percent (2% gateway + 18% GST = 2.36)
CONVENIENCE_FEE_PERCENT=2.36
# Development/test only: point the SDK at a local mock gateway. Never set in production.
RAZORPAY_API_URL=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
